{
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/eft-prosper-multumesc",
      "destination": "/eft-prosper-multumesc.html"
    }
  ],
  "redirects": [
    {
      "source": "/membership.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/membership",
      "destination": "/",
      "permanent": true
    }
  ]
}
